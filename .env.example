# Environment Variables for GS Gacuba Website & API

# Web Configuration
VITE_APP_TITLE=GS Gacuba II A | Excellence in Education
VITE_API_BASE_URL=/api
VITE_ENABLE_ANALYTICS=false

# Backend API Configuration
PORT=3000
NODE_ENV=development
API_PORT=3001
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=gs_gacuba_secret_key_change_in_production
DATABASE_URL=sqlite://./data/gs_gacuba.db

# Email Notification Configuration (Optional SMTP)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=admin@gsgacuba2a.rw
